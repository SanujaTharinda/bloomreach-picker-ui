# ResourceSpace Environment Variables
# Copy this file to .env and fill in the values
# DO NOT commit .env to git!

# =============================================================================
# SECRETS (REQUIRED - no defaults)
# =============================================================================

# Database password
DB_PASSWORD=your-db-password-here

# Security keys (from initial RS setup - MUST match for file access)
RS_SCRAMBLE_KEY=your-scramble-key-here
RS_API_SCRAMBLE_KEY=your-api-scramble-key-here

# =============================================================================
# OPTIONAL (have defaults)
# =============================================================================

# Database connection
# DB_HOST=mariadb
# DB_NAME=resourcespace
# DB_USER=resourcespace_rw

# ResourceSpace settings
# RS_PORT=8080
# RS_BASE_URL=http://localhost:8080
# RS_APP_NAME=ResourceSpace

# Email settings
# RS_EMAIL_FROM=noreply@localhost
# RS_EMAIL_NOTIFY=admin@localhost

# Debug logging (set to 'true' to enable)
# RS_DEBUG=false
