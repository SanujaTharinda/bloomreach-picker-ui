# Dependencies
node_modules/
npm-debug.log*

# Build output (we rebuild in container)
dist/

# Environment files (should be passed via docker-compose or runtime)
.env
.env.*
!.env.example

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Migration output (mounted as volume, not built into image)
migration-output/

# Documentation (not needed in container)
*.md
!README.md

# Test files
*.test.ts
*.spec.ts
__tests__/
coverage/

# TypeScript build info
*.tsbuildinfo

# Logs
logs/
*.log

